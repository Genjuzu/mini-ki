# Mini-KI auf diesem Gerät. Diese Datei hat absichtlich keine Werte.
# Kopieren nach .env und dort eintragen. .env bleibt außerhalb des Repository.

# Port auf 127.0.0.1. Leer lässt die Voreinstellung aus compose.yaml.
MINI_KI_PORT=

# Optionaler Zugang (Bearer). Leer lässt den Dienst ohne Schlüssel.
MINI_KI_ZUGANG=
